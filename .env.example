# ==============================================================================
# DrillAI — Well Engineering Intelligence Platform
# Example Environment Configuration (.env.example)
# Copy to .env and customize for your deployment. Never commit real secrets.
# ==============================================================================

# --- Core Environment & Security ---
DRILLAI_ENVIRONMENT=staging
DRILLAI_DEBUG=false
DRILLAI_LOG_LEVEL=INFO
DRILLAI_LOG_JSON=true
DRILLAI_AUTH_ENABLED=true
DRILLAI_CORS_ORIGINS=http://localhost:8080
DRILLAI_E2E_FAULTS=false

# --- PostgreSQL Database ---
POSTGRES_USER=drillai
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=drillai
POSTGRES_PORT=5432
DRILLAI_DATABASE_URL=postgresql+asyncpg://drillai:change_me_in_production@postgres:5432/drillai
DRILLAI_DB_POOL_SIZE=10
DRILLAI_DB_MAX_OVERFLOW=10

# --- Blob & Vector Storage ---
DRILLAI_BLOB_BACKEND=filesystem
DRILLAI_BLOB_ROOT=/var/lib/drillai/blobs
DRILLAI_VECTOR_BACKEND=in_memory

# --- AI & Embedding Providers (optional; defaults to deterministic stub) ---
DRILLAI_LLM_PROVIDER=stub
DRILLAI_EMBEDDING_PROVIDER=deterministic

# --- Telemetry Freshness & Window Bounds ---
DRILLAI_TELEMETRY_FRESH_SECONDS=30.0
DRILLAI_TELEMETRY_STALE_SECONDS=300.0
DRILLAI_TELEMETRY_LATE_SECONDS=120.0
DRILLAI_TELEMETRY_MAX_LATEST_CHANNELS=200
DRILLAI_TELEMETRY_MAX_WINDOW_POINTS=2000
DRILLAI_TELEMETRY_MAX_BATCH_POINTS=5000

# --- Telemetry Connectors & Durable Worker ---
DRILLAI_WITSML_CONNECTOR_ENABLED=true
DRILLAI_ETP_CONNECTOR_ENABLED=true
# Never enable loopback in production (startup will fail-closed if true in production)
DRILLAI_CONNECTOR_ALLOW_LOOPBACK=false
# Comma-separated allowlist for private-network rig historians (e.g. witsml.rig01.corp.example)
DRILLAI_CONNECTOR_ALLOWED_HOSTS=
# Set to false when running the dedicated connector-worker container/process
DRILLAI_CONNECTOR_WORKER_ENABLED=false
DRILLAI_CONNECTOR_WORKER_LEASE_SECONDS=30.0
DRILLAI_CONNECTOR_WORKER_POLL_SECONDS=1.0
DRILLAI_CONNECTOR_WORKER_MAX_CONCURRENCY=8
DRILLAI_CONNECTOR_RUN_RETENTION_LIMIT=100
DRILLAI_CONNECTOR_MAX_RESPONSE_BYTES=5242880
DRILLAI_CONNECTOR_REQUEST_TIMEOUT_SECONDS=10.0

# --- Referenced Connector Secrets (resolved via env:DRILLAI_SECRET_<NAME>) ---
# DRILLAI_SECRET_RIG01_WITSML_USER=
# DRILLAI_SECRET_RIG01_WITSML_PASS=
# DRILLAI_SECRET_RIG01_ETP_TOKEN=
